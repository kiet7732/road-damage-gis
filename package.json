  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.0.2",
    "@react-navigation/bottom-tabs": "^7.18.16",
    "@react-navigation/native": "^7.3.16",
    "@react-navigation/native-stack": "^7.18.8",
    "@types/leaflet": "^1.9.22",
    "axios": "^1.19.0",
    "babel-preset-expo": "~54.0.10",
    "expo": "~54.0.37",
    "expo-camera": "~17.0.10",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.12",
    "expo-image-manipulator": "~14.0.8",
    "expo-location": "~19.0.8",
    "expo-navigation-bar": "~5.0.10",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "leaflet": "^1.9.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-icons": "^5.7.0",
    "react-leaflet": "^5.0.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-maps": "1.20.1",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.5.1",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1"
  },
  "scripts": {
    "start": "expo start",
    "check:types": "tsc --noEmit",
    "check:workspace": "npm run check:types",
    "start:reporter": "powershell -ExecutionPolicy Bypass -Command \"$env:EXPO_PUBLIC_APP_TARGET='reporter'; expo start\"",
    "start:engineer": "powershell -ExecutionPolicy Bypass -Command \"$env:EXPO_PUBLIC_APP_TARGET='engineer'; expo start\"",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "web:reporter": "powershell -ExecutionPolicy Bypass -Command \"$env:EXPO_PUBLIC_APP_TARGET='reporter'; expo start --web\"",
    "web:engineer": "powershell -ExecutionPolicy Bypass -Command \"$env:EXPO_PUBLIC_APP_TARGET='engineer'; expo start --web\"",
    "android:reporter": "powershell -ExecutionPolicy Bypass -Command \"$env:EXPO_PUBLIC_APP_TARGET='reporter'; expo start --android\"",
    "android:engineer": "powershell -ExecutionPolicy Bypass -Command \"$env:EXPO_PUBLIC_APP_TARGET='engineer'; expo start --android\"",
    "ios:reporter": "powershell -ExecutionPolicy Bypass -Command \"$env:EXPO_PUBLIC_APP_TARGET='reporter'; expo start --ios\"",
    "ios:engineer": "powershell -ExecutionPolicy Bypass -Command \"$env:EXPO_PUBLIC_APP_TARGET='engineer'; expo start --ios\"",
    "dev:web": "expo start --web --port 8081",
    "dev:web-admin": "vite --config apps/web-admin/vite.config.ts --host 0.0.0.0 --port 5173",
    "dev:services": "powershell -ExecutionPolicy Bypass -File ./scripts/dev-services.ps1",
    "dev:backend": "powershell -ExecutionPolicy Bypass -File ./scripts/run-backend.ps1",
    "dev:ai": "powershell -ExecutionPolicy Bypass -File ./scripts/run-ai.ps1",
    "dev:all": "powershell -ExecutionPolicy Bypass -File ./scripts/dev-up.ps1",
    "setup:local": "powershell -ExecutionPolicy Bypass -File ./scripts/setup-local.ps1",
    "check:ready": "powershell -ExecutionPolicy Bypass -File ./scripts/check-readiness.ps1",
    "data:seed": "powershell -ExecutionPolicy Bypass -Command \"$env:PYTHONPATH=(Resolve-Path './services/backend-api').Path; python ./services/backend-api/scripts/seed_demo_data.py\"",
    "data:seed:engineer": "powershell -ExecutionPolicy Bypass -Command \"$env:PYTHONPATH=(Resolve-Path './services/backend-api').Path; python ./services/backend-api/scripts/seed_engineer_demo_data.py\"",
    "qa:e2e:mobile-admin-list": "powershell -ExecutionPolicy Bypass -Command \"$env:PYTHONPATH=(Resolve-Path './services/backend-api').Path; python ./services/backend-api/scripts/run_mobile_to_admin_list_e2e.py\"",
    "qa:e2e:mobile-admin-map": "powershell -ExecutionPolicy Bypass -Command \"$env:PYTHONPATH=(Resolve-Path './services/backend-api').Path; python ./services/backend-api/scripts/run_mobile_to_admin_map_e2e.py\"",
    "qa:e2e:admin-status-mobile": "powershell -ExecutionPolicy Bypass -Command \"$env:PYTHONPATH=(Resolve-Path './services/backend-api').Path; python ./services/backend-api/scripts/run_admin_status_to_mobile_e2e.py\"",
    "qa:e2e:manual-review": "powershell -ExecutionPolicy Bypass -Command \"$env:PYTHONPATH=(Resolve-Path './services/backend-api').Path; python ./services/backend-api/scripts/run_manual_review_e2e.py\""
  },
  "private": true,
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.1.10",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "~5.9.2",
    "vite": "^7.1.3"
  }
}
