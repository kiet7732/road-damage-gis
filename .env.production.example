# =============================================================================
# Road Damage GIS - Production Environment Configuration Template
# Sao chép file này thành .env.production trên máy chủ EC2:
# cp .env.production.example .env.production
# =============================================================================

# --- Môi trường & Backend API ---
APP_ENV=production
BACKEND_HOST=0.0.0.0
BACKEND_PORT=5000
BACKEND_PUBLIC_BASE_URL=https://roaddamage-gis.duckdns.org
BACKEND_API_URL=https://roaddamage-gis.duckdns.org/api
BACKEND_API_PREFIX=/api
BACKEND_UPLOAD_URL_PREFIX=/uploads

# --- Lưu trữ tập tin & Upload ---
BACKEND_UPLOAD_DIR=/app/uploads/reports
BACKEND_MAX_UPLOAD_SIZE_MB=15
BACKEND_MAX_AI_IMAGE_DIMENSION=1280
BACKEND_MAX_GPS_ACCURACY_METERS=80
BACKEND_MAX_NOTE_LENGTH=500

# --- Cơ sở dữ liệu PostgreSQL 16 & PostGIS 3.4 (Nội bộ Docker) ---
GIS_BACKEND=postgis
GIS_SRID=4326
POSTGRES_HOST=postgis
POSTGRES_PORT=5432
POSTGRES_DB=road_damage_gis
POSTGRES_USER=rdg_admin
POSTGRES_PASSWORD=rdg_super_secure_password_2026
POSTGRES_POOL_MIN_SIZE=5
POSTGRES_POOL_MAX_SIZE=15
DATABASE_URL=postgresql://rdg_admin:rdg_super_secure_password_2026@postgis:5432/road_damage_gis

# --- Dịch vụ Trí tuệ Nhân tạo AI (Nội bộ Docker) ---
AI_SERVICE_URL=http://ai-service:8001
AI_DETECT_ENDPOINT=/api/ai/detect-road-damage
AI_TIMEOUT_SECONDS=15

# --- Dịch vụ GIS & OpenStreetMap Reverse Geocode ---
NOMINATIM_SERVER_URL=http://none
NOMINATIM_FALLBACK_URL=https://nominatim.openstreetmap.org
NOMINATIM_TIMEOUT_SECONDS=2.5
GEOCODING_CACHE_RADIUS_METERS=15.0
NOMINATIM_USER_AGENT=RoadDamageGIS-Production/1.0 (contact: admin@roaddamagegis.duckdns.org)

# --- Bảo mật & Xác thực (JWT / Cookies) ---
JWT_SECRET_KEY=k9Fm2Lx9Qw4Za1Vs8B2pX7dE5yN3hG0rJ_road_damage_gis_prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14
WEB_ACCESS_COOKIE_NAME=rdg_access_token
WEB_REFRESH_COOKIE_NAME=rdg_refresh_token
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# --- CORS Origins (Cho phép Mobile & Web Admin truy cập) ---
CORS_ALLOWED_ORIGINS=*
CORS_ALLOWED_ORIGINS_PROD=*
