# ================================
# Road Damage GIS - Shared env
# Sao chép file này thành .env tại thư mục root của repo.
# Frontend Expo/Web sẽ đọc trực tiếp file .env ở root.
# Backend API và AI Service cũng đã được cấu hình để fallback về file .env ở root.
# ================================

# App environment
# development | staging | production
APP_ENV=development

# ----------------
# Backend API
# ----------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=5000
BACKEND_PUBLIC_BASE_URL=http://localhost:5000
BACKEND_API_URL=http://localhost:5000/api
BACKEND_UPLOAD_URL_PREFIX=/uploads
BACKEND_API_PREFIX=/api
BACKEND_DATABASE_PATH=./data/road_damage_gis.db
BACKEND_UPLOAD_DIR=./uploads/reports
BACKEND_MAX_UPLOAD_SIZE_MB=15
BACKEND_MAX_AI_IMAGE_DIMENSION=1600
BACKEND_MAX_GPS_ACCURACY_METERS=80
BACKEND_MAX_NOTE_LENGTH=500

# ----------------
# AI Service
# ----------------
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8001
AI_SERVICE_URL=http://192.168.1.54:8001
AI_API_PREFIX=/api/ai
AI_DETECT_ENDPOINT=/api/ai/detect-road-damage
AI_TIMEOUT_SECONDS=20
AI_MODEL_PATH=./models/yolo12s_800px_seed0_best.pt
AI_IMAGE_SIZE=1216
AI_CONFIDENCE_THRESHOLD=0.05
AI_IOU_THRESHOLD=0.45
AI_DEVICE=auto
AI_INFERENCE_TIMEOUT_SECONDS=25
AI_MAX_UPLOAD_SIZE_MB=15
AI_MAX_IMAGE_DIMENSION=1600
AI_MAX_IMAGE_PIXELS=25000000

# ----------------
# Auth / Cookie
# ----------------
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
WEB_ACCESS_COOKIE_NAME=rdg_access_token
WEB_REFRESH_COOKIE_NAME=rdg_refresh_token
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# ----------------
# CORS
# ----------------
CORS_ALLOWED_ORIGINS=
CORS_ALLOWED_ORIGINS_DEV=http://localhost:8081,http://localhost:5173,http://127.0.0.1:8081,http://127.0.0.1:5173,http://192.168.1.54:8081,http://192.168.1.54:5173
CORS_ALLOWED_ORIGINS_STAGING=
CORS_ALLOWED_ORIGINS_PROD=
AI_CORS_ALLOWED_ORIGINS=http://localhost:5000,http://localhost:8081,http://localhost:5173,http://127.0.0.1:5000,http://127.0.0.1:8081,http://127.0.0.1:5173,http://192.168.1.54:5000,http://192.168.1.54:8081,http://192.168.1.54:5173

# ----------------
# Frontend clients
# ----------------
# Expo: chỉ biến EXPO_PUBLIC_* mới đi vào app bundle
EXPO_PUBLIC_API_URL=http://192.168.1.54:5000/api

# Web Admin / Vite
VITE_API_URL=http://192.168.1.54:5000/api

# CRA fallback nếu sau này cần
REACT_APP_API_URL=http://192.168.1.54:5000/api

# Node/browser shared fallback cho package dùng chung
API_URL=http://192.168.1.54:5000/api
