# =============================================================================
# Road Damage GIS - Backend API Environment Configuration Template
# =============================================================================

APP_ENV=development
BACKEND_HOST=127.0.0.1
BACKEND_PORT=5000
BACKEND_PUBLIC_BASE_URL=http://localhost:5000
BACKEND_API_URL=http://localhost:5000/api
BACKEND_API_PREFIX=/api
BACKEND_UPLOAD_URL_PREFIX=/uploads

BACKEND_DATABASE_PATH=./data/road_damage_gis.db
BACKEND_UPLOAD_DIR=./uploads/reports
BACKEND_MAX_UPLOAD_SIZE_MB=15
BACKEND_MAX_AI_IMAGE_DIMENSION=1600
BACKEND_MAX_GPS_ACCURACY_METERS=80
BACKEND_MAX_NOTE_LENGTH=500

AI_SERVICE_URL=http://localhost:8001
AI_DETECT_ENDPOINT=/api/ai/detect-road-damage
AI_TIMEOUT_SECONDS=20

GIS_BACKEND=sqlite
GIS_SRID=4326

# PostgreSQL 16 & PostGIS 3.4
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=road_damage_gis
POSTGRES_USER=rdg_admin
POSTGRES_PASSWORD=rdg_secret_postgis_2026
POSTGRES_POOL_MIN_SIZE=5
POSTGRES_POOL_MAX_SIZE=20
DATABASE_URL=postgresql://rdg_admin:rdg_secret_postgis_2026@127.0.0.1:5432/road_damage_gis

# Local Nominatim Docker Container
NOMINATIM_SERVER_URL=http://localhost:8080
NOMINATIM_FALLBACK_URL=https://nominatim.openstreetmap.org
NOMINATIM_TIMEOUT_SECONDS=2.0
GEOCODING_CACHE_RADIUS_METERS=15.0
NOMINATIM_USER_AGENT=RoadDamageGIS/1.0 (contact: admin@roaddamagegis.local)

JWT_SECRET_KEY=change-me-in-production-road-damage-gis-secret-key-32chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
WEB_ACCESS_COOKIE_NAME=rdg_access_token
WEB_REFRESH_COOKIE_NAME=rdg_refresh_token
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

CORS_ALLOWED_ORIGINS=
CORS_ALLOWED_ORIGINS_DEV=http://localhost:8081,http://localhost:5173,http://127.0.0.1:8081,http://127.0.0.1:5173

# Real Email SMTP (Gmail / Hòm thư thực tế)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Road Damage GIS
SMTP_USE_TLS=true
OTP_EXPIRE_SECONDS=300

