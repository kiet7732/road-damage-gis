# AI Service có thể đọc trực tiếp .env ở root của repo.
# File này dùng khi bạn muốn override riêng cho AI service.

AI_SERVICE_HOST=127.0.0.1
AI_SERVICE_PORT=8001
AI_SERVICE_URL=http://localhost:8001
AI_API_PREFIX=/api/ai
AI_MODEL_PATH=./models/yolo12s_800px_seed0_best.pt
AI_IMAGE_SIZE=1216
AI_CONFIDENCE_THRESHOLD=0.05
AI_IOU_THRESHOLD=0.45
AI_DEVICE=auto
AI_INFERENCE_TIMEOUT_SECONDS=25
AI_MAX_UPLOAD_SIZE_MB=15
AI_MAX_IMAGE_DIMENSION=1600
AI_MAX_IMAGE_PIXELS=25000000
AI_CORS_ALLOWED_ORIGINS=http://localhost:5000,http://localhost:8081,http://localhost:5173,http://127.0.0.1:5000,http://127.0.0.1:8081,http://127.0.0.1:5173
